{
  "name": "traductor-auth-server",
  "version": "1.0.0",
  "description": "Better Auth server for Traductor Desktop - Self-hosted authentication with ephemeral Gemini tokens",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "setup": "npm run prisma:generate && npm run prisma:push",
    "deploy": "fly deploy",
    "deploy:staging": "fly deploy --config fly.staging.toml",
    "logs": "fly logs",
    "status": "fly status",
    "secrets": "fly secrets list"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@prisma/client": "^6.9.0",
    "@upstash/redis": "^1.38.2",
    "better-auth": "^1.3.0",
    "dotenv": "^16.5.0",
    "hono": "^4.7.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
