# ============================================================================
# Traductor Auth Server - Environment Configuration
# ============================================================================
# 
# Architecture: Hexagonal (Ports & Adapters)
# Stack Options:
#   - AWS (current): EC2 + Neon PostgreSQL + Upstash Redis
#   - Hetzner (future): VPS + Local PostgreSQL + Local Redis
# 
# ============================================================================

# Server Configuration
PORT=3100
NODE_ENV=development
LOG_LEVEL=info

# ============================================================================
# Better Auth Configuration
# ============================================================================
# Genera un secret aleatorio con: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3100
SESSION_EXPIRY_DAYS=7

# Trusted Origins (URLs de las apps cliente permitidas)
# Para producción usar tu dominio: https://auth.niklauss.uk
TRUSTED_ORIGINS=tauri://localhost,http://localhost:5173,https://traductor.app

# ============================================================================
# Database Configuration
# ============================================================================
# 
# OPTION 1: Neon PostgreSQL (Serverless) - CURRENT
# 1. Crear cuenta GRATIS en: https://neon.tech
# 2. Crear proyecto "traductor-auth"
# 3. Copiar connection string (pooled)
# 
# OPTION 2: Local PostgreSQL (Hetzner migration)
# Use docker-compose.yml or install PostgreSQL directly
# 
# Formato: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/traductor?schema=public"
DATABASE_POOL_SIZE=10
DATABASE_SSL=true

# ============================================================================
# Cache Configuration
# ============================================================================
# 
# OPTION 1: Upstash Redis (Serverless) - CURRENT
# 1. Crear cuenta GRATIS en: https://upstash.com
# 2. Crear database Redis (seleccionar región cercana)
# 3. Copiar REST URL y Token desde la consola
# Free tier: 10,000 comandos/día
#
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# OPTION 2: Local Redis (Hetzner migration)
# Use docker-compose.yml or install Redis directly
# Comment out UPSTASH vars and set these instead:
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ============================================================================
# Multi-Tenant Application Support
# ============================================================================
# Enable when you have multiple apps using this auth server
ENABLE_MULTI_TENANT=false
DEFAULT_APP_ID=traductor-desktop

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_TOKENS_WINDOW_MS=60000
RATE_LIMIT_TOKENS_MAX=10
RATE_LIMIT_USAGE_WINDOW_MS=60000
RATE_LIMIT_USAGE_MAX=60

# ============================================================================
# OAuth Providers
# ============================================================================
# Google OAuth - Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# Gemini API Configuration (para tokens efímeros)
# ============================================================================
# API Key maestra del servidor para generar tokens efímeros
# Esta key se usa cuando los usuarios tienen plan Starter/Pro (no BYOK)
# Obtener en: https://aistudio.google.com/apikey
GEMINI_MASTER_API_KEY=your-gemini-api-key
TOKEN_EXPIRY_HOURS=1

# ============================================================================
# Stripe Configuration (para suscripciones de pago)
# ============================================================================
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Product IDs de Stripe (crear en Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PRO_PRICE_ID=price_pro_monthly

# ============================================================================
# Production URLs (después del deploy)
# ============================================================================
# BETTER_AUTH_URL=https://auth.niklauss.uk
# TRUSTED_ORIGINS=tauri://localhost,https://traductor.app,https://walltrow.app
